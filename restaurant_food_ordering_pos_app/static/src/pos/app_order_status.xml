<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="restaurant_food_ordering_pos_app.AppStatusBadge">
        <span t-if="_appStatus" t-attf-class="badge rounded text-bg-{{_appStatus.color}} ms-1" style="font-size: 0.75rem !important;">
            <i class="fa fa-mobile me-1"/><t t-esc="_appStatus.label"/>
        </span>
    </t>

    <t t-name="restaurant_food_ordering_pos_app.AppStatusButtons">
        <t t-if="isOpenAppOrder(_appOrder)">
            <t t-set="_appStatus" t-value="appStatus(_appOrder)"/>
            <button t-if="_appStatus.next" class="btn btn-lg btn-primary text-nowrap app-status-next"
                    t-on-click.stop="() => this.onClickAppNextStatus(_appOrder)">
                <i class="fa fa-arrow-right me-1"/><t t-esc="_appStatus.action"/>
            </button>
            <button t-if="_appOrder.marketplace_state === 'new' or !_appOrder.marketplace_state"
                    class="btn btn-lg btn-outline-danger text-nowrap app-status-cancel"
                    t-on-click.stop="() => this.onClickAppCancel(_appOrder)">
                <i class="fa fa-times me-1"/>Cancel
            </button>
        </t>
    </t>

    <!-- Product screen: status + next step of the current app order -->
    <t t-name="restaurant_food_ordering_pos_app.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="after">
            <t t-if="!props.showRemainingButtons and isOpenAppOrder(currentOrder)">
                <t t-set="_appStatus" t-value="appStatus(currentOrder)"/>
                <span t-attf-class="btn btn-lg text-bg-{{_appStatus.color}} pe-none text-nowrap">
                    <i class="fa fa-mobile me-1"/><t t-esc="_appStatus.label"/>
                </span>
                <t t-set="_appOrder" t-value="currentOrder"/>
                <t t-call="restaurant_food_ordering_pos_app.AppStatusButtons"/>
            </t>
        </xpath>
    </t>

    <!-- Orders screen: status badge in the list + actions on the selected order -->
    <t t-name="restaurant_food_ordering_pos_app.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[@id='order-tags']" position="after">
            <t t-set="_appStatus" t-value="appStatus(order)"/>
            <t t-call="restaurant_food_ordering_pos_app.AppStatusBadge"/>
        </xpath>
        <xpath expr="//div[hasclass('mobileOrderList')]//div[hasclass('order-name')]" position="inside">
            <t t-set="_appStatus" t-value="appStatus(order)"/>
            <t t-call="restaurant_food_ordering_pos_app.AppStatusBadge"/>
        </xpath>
        <xpath expr="//button[hasclass('load-order-button') and hasclass('validation')]" position="before">
            <t t-set="_appOrder" t-value="_selectedSyncedOrder"/>
            <t t-call="restaurant_food_ordering_pos_app.AppStatusButtons"/>
        </xpath>
    </t>

</templates>
